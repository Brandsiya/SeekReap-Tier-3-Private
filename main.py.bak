import datetime
import subprocess
import tempfile
import os
import json as _json
import shutil
import logging
from fastapi import FastAPI, Request, HTTPException
from fastapi.responses import JSONResponse

# Setup logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = FastAPI()

@app.get("/")
def health():
    return {
        "status": "tier-3 worker alive",
        "service": "audio-processing",
    }

@app.get("/check-tools")
def check_tools():
    ffmpeg = subprocess.getoutput("which ffmpeg")
    fpcalc = subprocess.getoutput("which fpcalc")
    return {
        "ffmpeg": ffmpeg,
        "fpcalc": fpcalc
    }

@app.post("/internal/audio-fingerprint")
async def get_audio_fingerprint(request: Request):
    """Accept uploaded file and return fingerprint."""
    try:
        logger.info("=== Audio fingerprint request received ===")
        
        form = await request.form()
        logger.info(f"Form keys: {list(form.keys())}")
        
        file = form.get("file")
        if not file:
            logger.error("No 'file' field in form data")
            return JSONResponse(
                status_code=400,
                content={"error": "file required"}
            )
        
        logger.info(f"File received: {file.filename}, content-type: {file.content_type}")
        
        # Save uploaded file
        with tempfile.NamedTemporaryFile(delete=False, suffix=".tmp") as tmp:
            content = await file.read()
            tmp.write(content)
            input_path = tmp.name
            logger.info(f"Saved temp file: {input_path} ({len(content)} bytes)")
        
        with tempfile.TemporaryDirectory() as tmpdir:
            out_path = os.path.join(tmpdir, "audio.mp4")
            logger.info(f"Converting to {out_path}")
            
            # Check ffmpeg exists
            ffmpeg_path = shutil.which("ffmpeg")
            logger.info(f"Using ffmpeg at: {ffmpeg_path}")
            
            result = subprocess.run(
                [ffmpeg_path, "-y", "-i", input_path,
                 "-t", "120", "-vn", "-acodec", "aac", "-b:a", "128k", "-f", "mp4", out_path],
                capture_output=True, text=True, timeout=180
            )
            
            logger.info(f"ffmpeg returncode: {result.returncode}")
            if result.returncode != 0:
                logger.error(f"ffmpeg stderr: {result.stderr}")
                return JSONResponse(
                    status_code=500,
                    content={"error": f"ffmpeg failed: {result.stderr[:500]}"}
                )
            
            logger.info("ffmpeg conversion successful")
            
            # Check fpcalc exists
            fpcalc_path = shutil.which("fpcalc")
            logger.info(f"Using fpcalc at: {fpcalc_path}")
            logger.info(f"Output file exists: {os.path.exists(out_path)}")
            logger.info(f"Output file size: {os.path.getsize(out_path)}")
            
            fp_result = subprocess.run(
                [fpcalc_path, "-json", out_path],
                capture_output=True, text=True, timeout=30
            )
            
            logger.info(f"fpcalc returncode: {fp_result.returncode}")
            if fp_result.returncode != 0:
                logger.error(f"fpcalc stderr: {fp_result.stderr}")
                return JSONResponse(
                    status_code=500,
                    content={"error": f"fpcalc failed: {fp_result.stderr[:500]}"}
                )
            
            if not fp_result.stdout:
                logger.error("fpcalc returned empty output")
                return JSONResponse(
                    status_code=500,
                    content={"error": "fpcalc returned empty output"}
                )
            
            logger.info(f"fpcalc stdout length: {len(fp_result.stdout)}")
            logger.info(f"fpcalc stdout preview: {fp_result.stdout[:200]}")
            
            try:
                data = _json.loads(fp_result.stdout)
            except Exception as e:
                logger.error(f"Invalid fpcalc JSON: {e}")
                return JSONResponse(
                    status_code=500,
                    content={"error": f"invalid fpcalc JSON: {str(e)}"}
                )
            
            os.unlink(input_path)
            
            response = {
                "fingerprint": data.get("fingerprint"),
                "duration": float(data.get("duration", 0))
            }
            logger.info(f"Returning fingerprint for duration: {response['duration']}")
            return response
    
    except subprocess.TimeoutExpired as e:
        logger.error(f"Timeout: {e}")
        return JSONResponse(
            status_code=500,
            content={"error": f"Timeout: {str(e)}"}
        )
    except Exception as e:
        logger.error(f"Unexpected error: {e}")
        import traceback
        traceback.print_exc()
        return JSONResponse(
            status_code=500,
            content={"error": str(e)}
        )

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8080)

@app.post("/api/analyze")
async def analyze_content(request: Request):
    """Main analysis endpoint called by Tier-5 workers."""
    try:
        data = await request.json()
        logger.info(f"Received analyze request: {data}")
        
        content_id = data.get("content_id")
        content_hash = data.get("content_hash")
        content_type = data.get("content_type", "audio")
        content_data = data.get("content_data", {})
        
        if content_id is None:
            content_id = "unknown"
            logger.warning("Received request with no content_id, using unknown")
        
        logger.info(f"Analyzing content {content_id}, type={content_type}")
        
        audio_similarity = content_data.get("audio_similarity", 0.0)
        visual_similarity = content_data.get("visual_similarity", 0.0)
        duplicate_content = content_data.get("duplicate_content", False)
        flags = content_data.get("flags", [])
        
        id_prefix = content_id[:8] if content_id and len(content_id) >= 8 else (content_id or "unknown")
        
        result = {
            content_id: content_id,
            analysis: {
                risk_score: 0.15,
                risk_level: low,
                details: {
                    content_type: content_type,
                    analyzed_at: str(datetime.datetime.now()),
                    audio_similarity: audio_similarity,
                    visual_similarity: visual_similarity,
                    duplicate_content: duplicate_content,
                    flags: flags
                },
                proof: {
                    attestation: f"sr-{id_prefix}-{int(datetime.datetime.now().timestamp())}",
                    timestamp: datetime.datetime.utcnow().isoformat() + Z,
                    method: seekreap-tier3-analysis-v1
                }
            }
        }
        
        logger.info(f"Analysis complete for {content_id}")
        return JSONResponse(content=result)
        
    except Exception as e:
        logger.error(f"Analysis error: {e}", exc_info=True)
        return JSONResponse(
            status_code=500,
            content={"error": str(e), "detail": "Analysis failed"}
        )
async def health_check():
    """Health check endpoint for monitoring"""
    return {
        "status": "healthy",
        "service": "tier-3-analysis",
        "timestamp": datetime.datetime.utcnow().isoformat()
    }
