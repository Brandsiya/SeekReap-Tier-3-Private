from fastapi import FastAPI, Request
from typing import Dict

app = FastAPI()

def compute_risk_score(audio_similarity: float = 0.0,
                       visual_similarity: float = 0.0,
                       metadata_flags: int = 0) -> tuple[float, str]:
    meta_score = min(metadata_flags / 5.0, 1.0)
    risk_score = (
        audio_similarity * 0.5 +
        visual_similarity * 0.3 +
        meta_score * 0.2
    )
    risk_score = max(0.0, min(risk_score, 1.0))
    if risk_score >= 0.75:
        risk_level = "high"
    elif risk_score >= 0.4:
        risk_level = "medium"
    else:
        risk_level = "low"
    return risk_score, risk_level

@app.post("/api/analyze")
async def analyze_content(content_id: str, content_type: str, content_data: Dict) -> Dict:
    result = {
        "content_id": content_id,
        "content_type": content_type,
        "signals": content_data,
    }

    score, level = compute_risk_score(
        audio_similarity=content_data.get("audio_similarity", 0.0),
        visual_similarity=content_data.get("visual_similarity", 0.0),
        metadata_flags=len(content_data.get("flags", []))
    )

    result["risk_score"] = score
    result["risk_level"] = level
    return result

@app.get("/health")
async def health_check():
    return {"status": "ok"}
